# Supabase project URL, e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Safe to expose in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin, used for canonical URLs, Open Graph tags and the
# sitemap. No trailing slash. Example: https://www.sarapowersolution.com
NEXT_PUBLIC_SITE_URL=
